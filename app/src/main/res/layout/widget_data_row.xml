<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/row_label" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:textColor="#D6E6F7" android:textSize="14sp" android:maxLines="1"
        android:ellipsize="end"/>
    <TextView android:id="@+id/row_amount" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:textColor="#FFFFFF" android:textSize="16sp" android:gravity="end"
        android:maxLines="1"/>
</LinearLayout>
